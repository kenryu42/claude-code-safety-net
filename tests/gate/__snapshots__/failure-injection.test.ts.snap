    {
      "command": "rm -rf ./build",
      "kind": "command",
      "segment": "rm -rf ./build",
    },
  ],
  "intent": "scope_down",
  "level": "standard",
  "outcome": "deny",
  "reason": "rm -rf outside cwd is blocked. Retry deleting only explicit paths inside the current directory; escalate for anything outside it.",
  "ruleId": "rm.recursive-force-outside-cwd",
  "stage": "command-analysis",
}
`;

