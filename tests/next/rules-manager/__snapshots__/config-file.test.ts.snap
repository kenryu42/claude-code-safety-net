exports[`writing a scope file leaves what the shipped writer leaves writes the project starter rulebook 1`] = `
[
  {
    "kind": "directory",
    "mode": 448,
    "path": "scope",
  },
  {
    "kind": "directory",
    "mode": 448,
    "path": "scope/rules",
  },
  {
    "content": 
"{
  "rulebook_version": 1,
  "name": "project-rules",
  "version": "1.0.0",
  "description": "Project-specific CC Safety Net rules.",
  "author": "project",
  "allowed_commands": [
    "docker"
  ],
  "rules": [
    {
      "name": "block-docker-system-prune",
      "command": "docker",
      "subcommand": "system",
      "block_args": [
        "prune"
      ],
      "reason": "Use targeted cleanup instead."
    }
  ],
  "tests": [
    {
      "command": "docker system prune",
      "expect": "blocked",
      "rule": "block-docker-system-prune"
    }
  ]
}
"
,
    "kind": "file",
    "mode": 384,
    "path": "scope/rules/written.json",
  },
]
`;

