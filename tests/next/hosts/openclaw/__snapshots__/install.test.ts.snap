exports[`guarding the extension directory before a --force command lets a --force command touch our own packaged install 1`] = `
{
  "outcome": {
    "kind": "returned",
    "value": {
      "ok": true,
      "value": undefined,
    },
  },
  "tree": [
    {
      "kind": "directory",
      "mode": 493,
      "path": ".openclaw",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": ".openclaw/extensions",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": ".openclaw/extensions/cc-safety-net",
    },
    {
      "content": 
"// cc-safety-net managed OpenClaw plugin. Do not edit. Reinstall with: npx -y cc-safety-net install --openclaw
// version: dev
export default {};
"
,
      "kind": "file",
      "mode": 420,
      "path": ".openclaw/extensions/cc-safety-net/index.js",
    },
    {
      "content": 
"{"id":"cc-safety-net"}
"
,
      "kind": "file",
      "mode": 420,
      "path": ".openclaw/extensions/cc-safety-net/openclaw.plugin.json",
    },
    {
      "content": 
"{"name":"cc-safety-net"}
"
,
      "kind": "file",
      "mode": 420,
      "path": ".openclaw/extensions/cc-safety-net/package.json",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "tmp",
    },
  ],
}
`;

