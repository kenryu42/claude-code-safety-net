exports[`one OpenClaw tool call through both handlers a destructive command 1`] = `
{
  "entries": [
    {
      "entry": {
        "agent": "openclaw",
        "command": "rm -rf /",
        "cwd": "<root>/project",
        "decision": "deny",
        "intent": "hard_stop",
        "reason": "This path contains the protected policy config and you must not modify or delete it.",
        "segment": "/",
        "sessionId": "openclaw-1",
        "toolName": "exec",
        "v": "dev",
      },
      "file": "<root>-project/<month>/<date>-openclaw-1.jsonl",
    },
  ],
  "returned": {
    "block": true,
    "blockReason": 
"BLOCKED by CC Safety Net

Reason: This path contains the protected policy config and you must not modify or delete it.

Command: rm -rf /

Segment: /

Do not retry this operation or attempt any workaround (other tools, flags, or paths). Report the block to the user and continue with the rest of the task."
,
  },
  "stderr": [],
  "thrown": undefined,
}
`;

