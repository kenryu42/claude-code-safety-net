exports[`cli/commands/install the three definitions are identical on both implementations 1`] = `
{
  "description": "Install CC Safety Net into a coding agent CLI",
  "examples": [
    "cc-safety-net install",
    "cc-safety-net install --amp",
    "cc-safety-net install --agy-cli",
    "cc-safety-net install --claude-code",
    "cc-safety-net install --codex",
    "cc-safety-net install --cursor",
    "cc-safety-net install --gemini-cli",
    "cc-safety-net install --copilot-cli",
    "cc-safety-net install --grok-build",
    "cc-safety-net install --hermes-agent",
    "cc-safety-net install --kimi-code",
    "cc-safety-net install --openclaw",
    "cc-safety-net install --opencode",
    "cc-safety-net install --pi",
  ],
  "name": "install",
  "options": [
    {
      "description": "Install Amp Code plugin",
      "flags": "--amp",
    },
    {
      "description": "Install Antigravity CLI hook config",
      "flags": "--agy-cli",
    },
    {
      "description": "Install Claude Code plugin",
      "flags": "--claude-code",
    },
    {
      "description": "Install Codex plugin",
      "flags": "--codex",
    },
    {
      "description": "Install Cursor hook config",
      "flags": "--cursor",
    },
    {
      "description": "Install Gemini CLI extension",
      "flags": "--gemini-cli",
    },
    {
      "description": "Install GitHub Copilot CLI plugin",
      "flags": "--copilot-cli",
    },
    {
      "description": "Install Grok Build hook config",
      "flags": "--grok-build",
    },
    {
      "description": "Install Hermes Agent plugin",
      "flags": "--hermes-agent",
    },
    {
      "description": "Install Kimi Code hook config",
      "flags": "--kimi-code",
    },
    {
      "description": "Install OpenClaw plugin",
      "flags": "--openclaw",
    },
    {
      "description": "Install OpenCode plugin",
      "flags": "--opencode",
    },
    {
      "description": "Install Pi package",
      "flags": "--pi",
    },
    {
      "description": "Show this help",
      "flags": "-h, --help",
    },
  ],
  "usage": "install [TARGET_FLAG]",
}
`;

