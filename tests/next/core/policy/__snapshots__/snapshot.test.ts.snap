exports[`the policy loader port reproduces every configuration recovery row loads a valid policy and a valid rulebook in each scope identically 1`] = `
{
  "diagnostics": [],
  "policy": {
    "destructiveCommandAllowPaths": [
      "~/scratch",
    ],
    "destructiveCommandProtectionEnabled": true,
    "destructiveCommandRuleOverrides": {
      "git.checkout-force": "off",
    },
    "rules": [
      {
        "block_args": [
          "--environment=prod",
        ],
        "command": "deploybot",
        "intent": "manual_only",
        "match": undefined,
        "name": "team/block-prod-release",
        "reason": "Production releases go through the release checklist.",
        "subcommand": "release",
      },
      {
        "block_args": [],
        "command": "stackctl",
        "intent": "manual_only",
        "match": {
          "any_args": [
            "--purge",
          ],
          "command_path": [
            "space",
          ],
        },
        "name": "v2team/block-space-purge",
        "reason": "Purging a shared space cannot be undone from a session.",
      },
    ],
    "safety": {
      "level": "strict",
      "overrides": {
        "failClosed": true,
      },
    },
    "secretProtection": {
      "allowPaths": [],
      "denyPaths": [
        " private/token.txt ",
      ],
      "disabledRules": [
        "secret.cli.claude-code.config",
        "secret.cli.antigravity",
        "secret.cli.gemini.config",
        "secret.cli.copilot-cli.config",
        "secret.cli.kimi-code.config",
        "secret.cli.opencode.config",
        "secret.cli.pi.config",
        "secret.cli.amp.config",
        "secret.cli.cursor.config",
        "secret.cli.grok-build.config",
        "secret.basename.env",
      ],
      "enabled": true,
    },
    "transparentWrappers": [
      "runner",
      "shared-wrap",
      "projrunner",
    ],
    "worktreeMode": false,
  },
  "ruleMetadata": {
    "team/block-prod-release": {
      "id": "team/block-prod-release",
      "rulebook": {
        "name": "team",
        "version": "1.4.0",
      },
      "source": "team",
    },
    "v2team/block-space-purge": {
      "id": "v2team/block-space-purge",
      "rulebook": {
        "name": "v2team",
        "version": "2.1.0",
      },
      "source": "v2team",
    },
  },
  "state": "ready",
}
`;

