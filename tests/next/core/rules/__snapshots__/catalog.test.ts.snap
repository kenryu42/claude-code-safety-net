    "id": "interpreter.one-liner-paranoid",
    "intent": "use_alternative",
    "label": "Interpreter one-liner paranoid mode",
  },
  {
    "category": "Execution",
    "description": "Blocks awk system calls that cannot be safely analyzed.",
