    "id": "find.exec-rm-recursive-force",
    "intent": "scope_down",
    "label": "find exec rm -rf",
  },
  {
    "category": "Filesystem",
    "description": "Blocks dd writing to a /dev device.",
    "example": "dd if=/dev/zero of=/dev/sda",
