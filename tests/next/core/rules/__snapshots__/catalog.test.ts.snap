  },
  {
    "category": "Filesystem",
    "description": "Blocks mkfs formatting a /dev device.",
    "example": "mkfs.ext4 /dev/sda1",
    "id": "mkfs.device",
    "intent": "manual_only",
    "label": "mkfs device format",
  },
  {
    "category": "Filesystem",
    "description": "Blocks shred against any target, including shred --help and shred --version.",
