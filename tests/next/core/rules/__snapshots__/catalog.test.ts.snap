exports[`rule catalogs secret records, matcher data, and tiers are identical 6`] = `
[
  {
    "category": "Variant",
    "description": "Blocks id_rsa variants with dash or underscore suffixes.",
    "id": "secret.variant.id-rsa.separator",
    "label": "id_rsa-* / id_rsa_*",
    "prefix": "id_rsa",
  },
  {
    "category": "Variant",
    "description": "Blocks id_dsa variants with dash or underscore suffixes.",
    "id": "secret.variant.id-dsa.separator",
    "label": "id_dsa-* / id_dsa_*",
    "prefix": "id_dsa",
  },
  {
    "category": "Variant",
    "description": "Blocks id_ed25519 variants with dash or underscore suffixes.",
    "id": "secret.variant.id-ed25519.separator",
    "label": "id_ed25519-* / id_ed25519_*",
    "prefix": "id_ed25519",
  },
  {
    "category": "Variant",
    "description": "Blocks id_ecdsa variants with dash or underscore suffixes.",
    "id": "secret.variant.id-ecdsa.separator",
    "label": "id_ecdsa-* / id_ecdsa_*",
    "prefix": "id_ecdsa",
  },
  {
    "category": "Variant",
    "description": "Blocks credentials variants with dash or underscore suffixes.",
    "id": "secret.variant.credentials.separator",
    "label": "credentials-* / credentials_*",
    "prefix": "credentials",
  },
]
`;

