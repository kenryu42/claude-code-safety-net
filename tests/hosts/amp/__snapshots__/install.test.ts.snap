exports[`publishing the plugin to the hosted repository writes the artifact into a fresh checkout, commits it and pushes 1`] = `
{
  "outcome": {
    "kind": "returned",
    "value": {
      "calls": [
        {
          "command": [
            "amp",
            "plugins",
            "repositories",
            "--json",
          ],
          "cwd": undefined,
        },
        {
          "command": [
            "amp",
            "clone",
            "user-plugins",
            "<home>/tmp/cc-safety-net-amp-<id>",
          ],
          "cwd": undefined,
        },
        {
          "command": [
            "git",
            "add",
            "--",
            "cc-safety-net/index.ts",
          ],
          "cwd": "<home>/tmp/cc-safety-net-amp-<id>",
        },
        {
          "command": [
            "git",
            "status",
            "--porcelain",
          ],
          "cwd": "<home>/tmp/cc-safety-net-amp-<id>",
        },
        {
          "command": [
            "git",
            "-c",
            "commit.gpgsign=false",
            "-c",
            "user.name=cc-safety-net",
            "-c",
            "user.email=cc-safety-net@localhost",
            "commit",
            "-m",
            "chore: update cc-safety-net plugin to vdev",
          ],
          "cwd": "<home>/tmp/cc-safety-net-amp-<id>",
        },
        {
          "command": [
            "git",
            "push",
            "origin",
            "HEAD",
          ],
          "cwd": "<home>/tmp/cc-safety-net-amp-<id>",
        },
      ],
      "result": {
        "kind": "returned",
        "value": {
          "alreadyInstalled": false,
          "path": "amp://user-plugins/cc-safety-net",
        },
      },
      "snapshots": {
        "git add -- cc-safety-net/index.ts": [
          {
            "kind": "directory",
            "path": "cc-safety-net",
          },
          {
            "content": 
"// cc-safety-net managed Amp plugin. Do not edit. Reinstall with: npx -y cc-safety-net install --amp
// version: dev
export default function plugin() {}
"
,
            "kind": "file",
            "path": "cc-safety-net/index.ts",
          },
        ],
      },
    },
  },
  "tree": [
    {
      "kind": "directory",
      "path": "tmp",
    },
  ],
}
`;

