"// cc-safety-net managed Amp plugin. Do not edit. Reinstall with: npx -y cc-safety-net install --amp
// version: dev
export default function plugin() {}
;globalThis.__CC_SAFETY_NET_EMBEDDED_POLICY__ = {"version":1,"safety":{"level":"strict","overrides":{}},"workflow":{"worktree_mode":false},"destructive_command_protection":{"enabled":true,"overrides":{},"allow_paths":[]},"secret_protection":{"enabled":true,"overrides":{},"deny_paths":["~/vault"],"allow_paths":[]},"audit":{"retention_days":30}};
"
,
            "kind": "file",
            "path": "cc-safety-net/index.ts",
          },
        ],
      },
    },
  },
  "tree": [
    {
      "kind": "directory",
      "path": ".cc-safety-net",
    },
    {
      "content": "{"version":1,"safety":{"level":"strict"},"secret_protection":{"deny_paths":["~/vault"]}}",
      "kind": "file",
      "path": ".cc-safety-net/policy.json",
    },
    {
      "kind": "directory",
      "path": "tmp",
    },
  ],
}
`;

