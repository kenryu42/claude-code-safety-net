// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`clearing the bunx cache removes only the entries this uid installed for this package 1`] = `
{
  "entries": [
    "bunx-<uid>-cc-safety-net-extra@1",
    "bunx-<other-uid>-cc-safety-net@1",
    "other",
  ],
  "tree": [
    {
      "kind": "directory",
      "path": "bunx-<uid>-cc-safety-net-extra@1",
    },
    {
      "content": "{}",
      "kind": "file",
      "path": "bunx-<uid>-cc-safety-net-extra@1/package.json",
    },
    {
      "kind": "directory",
      "path": "bunx-<other-uid>-cc-safety-net@1",
    },
    {
      "content": "{}",
      "kind": "file",
      "path": "bunx-<other-uid>-cc-safety-net@1/package.json",
    },
    {
      "kind": "directory",
      "path": "other",
    },
  ],
}
`;

