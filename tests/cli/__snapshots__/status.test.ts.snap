exports[`status an active project rulebook is counted 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": 
"CC Safety Net — ready

  Protection   destructive ok   secrets ok
  Level        standard
  Rules        1 active
  Policy       ~/.cc-safety-net/policy.json

  Not active
    - plugin cc-safety-net@cc-marketplace is disabled in Claude Code; nothing is
      enforced in Claude Code until it is re-enabled. Other integrations are not
      affected.

  Full report: cc-safety-net doctor
"
,
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "path": "project",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net/rules",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net/rules/project-rules",
    },
    {
      "content": 
"{
  "rulebook_version": 1,
  "name": "project-rules",
  "version": "1.0.0",
  "allowed_commands": [
    "docker"
  ],
  "rules": [
    {
      "name": "block-docker-system-prune",
      "command": "docker",
      "subcommand": "system",
      "block_args": [
        "prune"
      ],
      "reason": "Pruning the shared Docker host removes other work.",
      "intent": "manual_only"
    }
  ]
}
"
,
      "kind": "file",
      "path": "project/.cc-safety-net/rules/project-rules/rulebook.json",
    },
    {
      "content": 
"{
  "version": 1,
  "rules": [
    "project-rules"
  ]
}
"
,
      "kind": "file",
      "path": "project/.cc-safety-net/rules/rule.json",
    },
  ],
}
`;
