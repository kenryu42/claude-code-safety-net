exports[`status a project policy that weakens the user policy is named as such 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": 
"CC Safety Net — ready

  Protection   destructive ok   secrets ok
  Level        standard
  Rules        none active
  Policy       ~/.cc-safety-net/policy.json
  Project      <root>/project/.cc-safety-net/policy.json

  Project policy
    project policy lowers level: strict -> standard

  Not active
    - plugin cc-safety-net@cc-marketplace is disabled in Claude Code; nothing is
      enforced in Claude Code until it is re-enabled. Other integrations are not
      affected.

  Full report: cc-safety-net doctor
"
,
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/.cc-safety-net",
    },
    {
      "content": 
"{
  "version": 1,
  "safety": {
    "level": "strict"
  }
}
"
,
      "kind": "file",
      "path": "home/.cc-safety-net/policy.json",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "path": "project",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net",
    },
    {
      "content": 
"{
  "version": 1,
  "safety": {
    "level": "standard"
  }
}
"
,
      "kind": "file",
      "path": "project/.cc-safety-net/policy.json",
    },
  ],
}
`;

