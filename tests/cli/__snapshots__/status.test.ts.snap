// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`status a fresh home reports the disabled plugin and points at doctor 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": 
"CC Safety Net — ready

  Protection   destructive ok   secrets ok
  Level        standard
  Rules        none active
  Policy       ~/.cc-safety-net/policy.json

  Not active
    - plugin cc-safety-net@cc-marketplace is disabled in Claude Code; nothing is
      enforced in Claude Code until it is re-enabled. Other integrations are not
      affected.

  Full report: cc-safety-net doctor
"
,
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "path": "project",
    },
  ],
}
`;

