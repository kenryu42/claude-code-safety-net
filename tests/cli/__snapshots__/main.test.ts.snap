exports[`help \`help rule\` prints the command help 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": 
"cc-safety-net rule

  Manage CC Safety Net rule config and rulebook sources

USAGE:
  cc-safety-net rule <subcommand>

SUBCOMMANDS:
  init [--example]                                   Create inert rule config
  add [source] [--ref <ref>] [--only <rulebook...>]  Add rulebook sources and sync
  remove <source>                                    Remove a rulebook source and sync
  update [source]                                    Re-fetch and vendor remote rulebooks
  sync                                               Deprecated: migrate lock and cache leftovers
  list                                               List active rulebooks
  wrapper add <command>                              Trust a transparent command wrapper
  wrapper remove <command>                           Remove a transparent command wrapper
  wrapper list                                       List transparent command wrappers
  migrate [--cleanup]                                Migrate legacy inline rules
  doc                                                Print the rulebook authoring guide
  verify                                             Validate rule config files

OPTIONS:
  -g, --global          Use user-scope rule config
  --cleanup             Delete legacy files after rule migrate verifies them
  --delete-source       Delete clean local source directory on remove
  --example             Create an inactive example rulebook with rule init
  --ref <ref>           Use a branch, tag, or commit
  --only <rulebook...>  Add only these repository rulebooks
  -h, --help            Show this help

EXAMPLES:
  cc-safety-net rule init
  cc-safety-net rule init --example
  cc-safety-net rule wrapper add rtk
  cc-safety-net rule add project-rules
  cc-safety-net rule add acme/safety-rules
  cc-safety-net rule add acme/safety-rules --only aws gcloud
  cc-safety-net rule add acme/safety-rules --ref v2 --only aws
  cc-safety-net rule add --only terraform aws
  cc-safety-net rule update
  cc-safety-net rule migrate --cleanup
  cc-safety-net rule verify
"
,
  "tree": [
    {
      "kind": "directory",
      "mode": 493,
      "path": "home",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "project",
    },
  ],
}
`;

