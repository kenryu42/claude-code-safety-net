exports[`help \`help logs\` prints the command help 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": 
"cc-safety-net logs

  Browse audit log entries recorded by hooks

USAGE:
  cc-safety-net logs [options]

OPTIONS:
  --id <id>         Show one entry from retained history by its 16-character id (not guaranteed once it is older than the configured retention)
  --limit <n>       Maximum entries to print (default: 20)
  --since <days>    Only include entries newer than this many days (max: the configured audit retention, 1-365) (default: 30)
  --agent <name>    Filter by agent name
  --rule <ruleId>   Filter by rule id
  --session <id>    Filter by session id
  --project <path>  Filter by project path
  --suspect         Only denials that look like false positives
  --all             Include allow entries
  --prune-legacy    Permanently delete all legacy root-level logs; nested logs are untouched
  --dry-run         With --prune-legacy, report what would be deleted and delete nothing
  --json            Output entries as JSON
  -h, --help        Show this help

EXAMPLES:
  cc-safety-net logs --id 3fa9c2d1a70e8b42
  cc-safety-net logs --agent claude-code
  cc-safety-net logs --project . --since 7
  cc-safety-net logs --suspect --since 7
  cc-safety-net logs --json
  cc-safety-net logs --prune-legacy --dry-run
  cc-safety-net logs --prune-legacy
"
,
  "tree": [
    {
      "kind": "directory",
      "mode": 493,
      "path": "home",
