exports[`statusline the flag is required 1`] = `
{
  "exitCode": 1,
  "stderr": 
"statusline requires --claude-code (-cc)
cc-safety-net statusline

  Print status line with mode indicators for shell integration

USAGE:
  cc-safety-net statusline --claude-code

OPTIONS:
  -cc, --claude-code  Print status line for Claude Code
  -h, --help          Show this help

EXAMPLES:
  cc-safety-net statusline -cc
  cc-safety-net statusline --claude-code
"
,
  "stdout": "",
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "path": "project",
    },
  ],
}
`;

