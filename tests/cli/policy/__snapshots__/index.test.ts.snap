      "mode": 493,
      "path": "project",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "project/.cc-safety-net",
    },
    {
      "content": 
"{
  "version": 1,
  "safety": {
    "level": "strict"
  }
}
"
,
      "kind": "file",
      "mode": 384,
      "path": "project/.cc-safety-net/policy.json",
    },
    {
      "content": 
"{
  "version": 1,
  "safety": {
    "level": "strict"
  }
}
"
,
      "kind": "file",
      "mode": 420,
      "path": "project/prop.json",
    },
  ],
  "written": [
    "Scope: project (<root>/project/.cc-safety-net/policy.json)",
    "Proposal: <root>/project/prop.json",
