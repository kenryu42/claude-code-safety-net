// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`policy check a project proposal is reported against the merged effective policy 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": 
"Scope: project (<root>/project/.cc-safety-net/policy.json)
Proposal: prop.json
Effective policy (user + project merged):
Changes (1):
  safety.level: standard -> strict
"
,
  "tree": [
    {
      "kind": "directory",
      "mode": 493,
      "path": "home",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "project",
    },
    {
      "content": 
"{
  "version": 1,
  "safety": {
    "level": "strict"
  }
}
"
,
      "kind": "file",
      "mode": 420,
      "path": "project/prop.json",
    },
  ],
}
`;

