exports[`policy usage the bare verb prints its help on stderr 1`] = `
{
  "exitCode": 1,
  "stderr": 
"cc-safety-net policy

  Check and apply project or user policy proposals

USAGE:
  cc-safety-net policy <subcommand>

SUBCOMMANDS:
  check <file>  Validate a policy proposal and print its diff
  apply <file>  Apply a proposal after confirming in a terminal

OPTIONS:
  -g, --global  Use the user-scope policy instead of the project one
  -h, --help    Show this help

EXAMPLES:
  cc-safety-net policy check proposal.json
  cc-safety-net policy apply proposal.json
  cc-safety-net policy apply proposal.json --global
"
,
  "stdout": "",
  "tree": [
    {
      "kind": "directory",
      "mode": 493,
      "path": "home",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "project",
    },
  ],
}
`;

