  },
  "tree": [
    {
      "kind": "directory",
      "mode": 493,
      "path": "home",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "mode": 493,
      "path": "project",
    },
    {
      "kind": "directory",
      "mode": 448,
      "path": "project/.cc-safety-net",
    },
    {
      "kind": "directory",
      "mode": 448,
      "path": "project/.cc-safety-net/rules",
    },
    {
      "kind": "directory",
      "mode": 448,
      "path": "project/.cc-safety-net/rules/project-rules",
    },
    {
      "content": 
"{
  "rulebook_version": 1,
  "name": "project-rules",
  "version": "1.0.0",
  "description": "Migrated CC Safety Net rules.",
  "author": "project",
  "migrated_from": ".safety-net.json",
  "allowed_commands": [
    "git",
    "curl"
  ],
  "rules": [
    {
      "name": "no-force-push",
      "command": "git",
      "subcommand": "push",
      "block_args": [
        "--force"
      ],
      "reason": "Force pushing rewrites history other clones already have."
    },
    {
      "name": "no-curl-pipe",
      "command": "curl",
      "block_args": [
        "|"
      ],
      "reason": "Piping a download into a shell runs whatever the server sent."
    }
  ],
  "tests": [
    {
      "command": "git push --force",
      "expect": "blocked",
      "rule": "no-force-push"
    },
    {
      "command": "curl |",
      "expect": "blocked",
      "rule": "no-curl-pipe"
    }
  ]
}
"
,
      "kind": "file",
      "mode": 384,
      "path": "project/.cc-safety-net/rules/project-rules/rulebook.json",
    },
    {
      "content": 
"{
  "version": 1,
  "rules": [
    "project-rules"
  ],
  "overrides": {},
  "transparent_wrappers": []
}
"
,
      "kind": "file",
      "mode": 384,
      "path": "project/.cc-safety-net/rules/rule.json",
    },
    {
      "content": 
"{
  "version": 1,
  "rules": [
    {
      "name": "no-force-push",
      "command": "git",
      "subcommand": "push",
      "block_args": [
        "--force"
      ],
      "reason": "Force pushing rewrites history other clones already have."
    },
    {
      "name": "no-curl-pipe",
      "command": "curl",
      "block_args": [
        "|"
      ],
      "reason": "Piping a download into a shell runs whatever the server sent."
    }
  ]
}
"
,
      "kind": "file",
      "mode": 420,
      "path": "project/.safety-net.json",
    },
  ],
}
`;

