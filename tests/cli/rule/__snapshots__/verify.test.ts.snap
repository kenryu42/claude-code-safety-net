// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`rule verify no config anywhere reports the built-in rules alone 1`] = `
{
  "code": 0,
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
