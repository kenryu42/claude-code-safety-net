"
No config files found. Using built-in rules only."
,
  ],
}
`;

exports[`rule verify a valid user config gains its schema and lists its sources 1`] = `
{
  "code": 0,
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/.cc-safety-net",
    },
    {
      "kind": "directory",
      "path": "home/.cc-safety-net/rules",
    },
    {
      "content": 
"{
  "$schema": "https://raw.githubusercontent.com/kenryu42/cc-safety-net/main/assets/cc-safety-net.schema.json",
  "version": 1,
  "rules": [
    "team-rules"
  ]
}"
,
      "kind": "file",
      "path": "home/.cc-safety-net/rules/rule.json",
    },
    {
      "kind": "directory",
      "path": "home/.cc-safety-net/rules/team-rules",
    },
    {
      "content": "{"rulebook_version":2,"name":"team-rules","version":"1.0.0","allowed_commands":["docker"],"rules":[{"name":"block-system-prune","command":"docker","match":{"command_path":["system","prune"]},"reason":"Prune everything and an unrelated stopped container goes with it."}],"tests":[{"command":"docker system prune","expect":"blocked","rule":"block-system-prune"}]}",
      "kind": "file",
      "path": "home/.cc-safety-net/rules/team-rules/rulebook.json",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
  ],
  "written": [
    "CC Safety Net Config",
    "════════════════════",
    
"
Added $schema to user config."
,
    
"
✓ User config: <root>/home/.cc-safety-net/rules/rule.json"
,
    "  Schema: rulebook sources",
    "  Sources:",
    "    1. team-rules",
    
"
All configs valid."
,
  ],
}
`;

