exports[`rule verify a legacy user config on its own is reported as ignored 1`] = `
{
  "code": 0,
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/.cc-safety-net",
    },
    {
      "content": "{"version":1,"rules":[{"name":"no-force-push","command":"git","subcommand":"push","block_args":["--force"],"reason":"Force pushing rewrites history other clones already have."}]}",
      "kind": "file",
      "path": "home/.cc-safety-net/config.json",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
  ],
  "written": [
    "CC Safety Net Config",
    "════════════════════",
    
"
✗ Legacy user config: <root>/home/.cc-safety-net/config.json"
,
    "  Schema: legacy inline rules",
    "  Status: ignored by CC Safety Net",
    "  Rules:",
    "    1. no-force-push",
    
"
Warning: Legacy user config is ignored by CC Safety Net. Run \`npx -y cc-safety-net rule migrate\`."
,
    
"
Configs valid with warnings."
,
  ],
}
`;

