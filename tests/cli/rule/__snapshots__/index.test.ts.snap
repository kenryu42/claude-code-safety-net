Added rulebook source: team

Active rulebooks (1):
  - team 1.0.0 (1 rule)
    Source: team
"
,
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "path": "project",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net/rules",
    },
    {
      "content": 
"{
  "version": 1,
  "rules": [
    "team"
  ],
  "overrides": {},
  "transparent_wrappers": []
}
"
,
      "kind": "file",
      "path": "project/.cc-safety-net/rules/rule.json",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net/rules/team",
    },
    {
      "content": 
"{
  "rulebook_version": 1,
  "name": "team",
  "version": "1.0.0",
  "allowed_commands": [
    "docker"
  ],
  "rules": [
    {
      "name": "block-docker-system-prune",
      "command": "docker",
      "subcommand": "system",
      "block_args": [
        "prune"
      ],
      "reason": "Use targeted cleanup instead."
    }
  ]
}
"
,
      "kind": "file",
      "path": "project/.cc-safety-net/rules/team/rulebook.json",
    },
  ],
}
`;

