      "kind": "directory",
      "path": "project/.cc-safety-net/rules",
    },
    {
      "content": 
"{
  "version": 1,
  "rules": [
    "team"
  ],
  "overrides": {
    "team/block-tf-apply": "off"
  },
  "transparent_wrappers": [
    "doit"
  ]
}
"
,
      "kind": "file",
      "path": "project/.cc-safety-net/rules/rule.json",
    },
    {
      "kind": "directory",
      "path": "project/.cc-safety-net/rules/team",
    },
    {
      "content": 
"{
  "rulebook_version": 2,
  "name": "team",
  "version": "1.0.0",
  "allowed_commands": [
    "terraform"
  ],
  "rules": [
    {
      "name": "block-tf-destroy",
      "command": "terraform",
      "match": {
        "command_path": [
          "destroy"
        ],
        "any_args": [
          "-auto-approve"
        ],
        "exclude_args": [
          "-target"
        ]
      },
      "reason": "Destroys infrastructure."
    },
    {
      "name": "block-tf-apply",
      "command": "terraform",
      "match": {
        "command_path": [
          "apply"
        ]
      },
      "reason": "Apply from CI only."
    }
  ],
  "tests": [
    {
      "command": "terraform destroy -auto-approve",
      "expect": "blocked",
      "rule": "block-tf-destroy"
    }
  ]
}
"
,
      "kind": "file",
      "path": "project/.cc-safety-net/rules/team/rulebook.json",
    },
  ],
}
`;

