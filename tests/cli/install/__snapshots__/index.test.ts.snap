exports[`Amp commits the plugin with the embedded policy into the personal repository 1`] = `
{
  "errors": [],
  "exitCode": 0,
  "lines": [
    "Installed Amp Code plugin at amp://user-plugins/cc-safety-net",
    "Amp personal plugins apply to every Amp session, including Orb threads. Restart Amp or run "plugins: reload" to apply the change.",
    "",
  ],
  "log": [
    "amp clone user-plugins <root>/tmp/cc-safety-net-amp-<id>	<root>",
    "amp plugins repositories --json	<root>",
    "git -c commit.gpgsign=false -c user.name=cc-safety-net -c user.email=cc-safety-net@localhost commit -m chore: update cc-safety-net plugin to vdev	<root>/tmp/cc-safety-net-amp-<id>",
    "git add -- cc-safety-net/index.ts	<root>/tmp/cc-safety-net-amp-<id>",
    "git push origin HEAD	<root>/tmp/cc-safety-net-amp-<id>",
    "git status --porcelain	<root>/tmp/cc-safety-net-amp-<id>",
  ],
  "tmp": [
    {
      "kind": "directory",
      "path": "staged",
    },
    {
      "content": 
"personal plugins
"
,
      "kind": "file",
      "path": "staged/README.md",
    },
    {
      "kind": "directory",
      "path": "staged/cc-safety-net",
    },
    {
      "content": 
"<amp-artifact>;globalThis.__CC_SAFETY_NET_EMBEDDED_POLICY__ = {"version":1,"safety":{"level":"strict","overrides":{}},"workflow":{"worktree_mode":false},"destructive_command_protection":{"enabled":true,"overrides":{},"allow_paths":[]},"secret_protection":{"enabled":true,"overrides":{},"deny_paths":[],"allow_paths":[]},"audit":{"retention_days":30}};
"
,
      "kind": "file",
      "path": "staged/cc-safety-net/index.ts",
    },
  ],
  "tree": [
    {
      "kind": "directory",
      "path": ".cc-safety-net",
    },
    {
      "content": 
"{"safety":{"level":"strict"}}
"
,
      "kind": "file",
      "path": ".cc-safety-net/policy.json",
    },
    {
      "kind": "directory",
      "path": "tmp",
    },
  ],
  "warnings": [],
}
`;

