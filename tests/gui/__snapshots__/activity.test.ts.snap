exports[`the GUI activity feed drops the records it cannot read and counts them 1`] = `
{
  "counts": {
    "agents": {
      "claude-code": 3,
    },
    "allowed": 1,
    "analyzedByDay": [
      0,
      0,
      0,
      0,
      0,
      0,
      3,
    ],
    "blocked": 2,
    "blockedByDay": [
      0,
      0,
      0,
      0,
      0,
      0,
      2,
    ],
    "commands": {
      "git push": 2,
    },
    "errors": 1,
    "rules": {
      "destructive.git-push-force": 1,
    },
  },
  "days": 7,
  "entries": [
    {
      "agent": "claude-code",
      "command": "git push --force",
      "decision": "deny",
      "failureStage": "analysis",
      "ts": "<time>",
    },
    {
      "agent": "claude-code",
      "command": "ls",
      "decision": "allow",
      "ts": "<time>",
    },
    {
      "agent": "claude-code",
      "command": "git push --force",
      "decision": "deny",
      "ruleId": "destructive.git-push-force",
      "segment": "git push --force",
      "ts": "<time>",
    },
  ],
  "homeDir": "<home>",
  "logsDir": "<logs>",
  "totalInWindow": 3,
  "truncated": false,
  "unreadable": 2,
}
`;

