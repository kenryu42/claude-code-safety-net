exports[`the GUI installer wrapper installs and removes the target the GUI asked for, reporting what it wrote 1`] = `
{
  "install": {
    "ok": true,
    "output": "Installed Cursor hook in <home>/.cursor/hooks.json",
  },
  "installed": [
    {
      "kind": "directory",
      "path": ".cursor",
    },
    {
      "content": 
"{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "npx -y cc-safety-net hook --cursor",
        "timeout": 30,
        "failClosed": true
      }
    ]
  }
}
"
,
      "kind": "file",
      "path": ".cursor/hooks.json",
    },
    {
      "kind": "directory",
      "path": "tmp",
    },
  ],
  "removed": [
    {
      "kind": "directory",
      "path": ".cursor",
    },
    {
      "content": 
"{
  "version": 1,
  "hooks": {
    "preToolUse": []
  }
}
"
,
      "kind": "file",
      "path": ".cursor/hooks.json",
    },
    {
      "kind": "directory",
      "path": "tmp",
    },
  ],
  "uninstall": {
    "ok": true,
    "output": "Uninstalled Cursor hook from <home>/.cursor/hooks.json",
  },
}
`;

exports[`the GUI installer wrapper reports a failed install with the error the installer printed 1`] = `
{
  "ok": false,
  "output": "EEXIST: file already exists, mkdir '<home>/.cursor'",
}
`;

exports[`the GUI installer wrapper serializes overlapping runs so neither captures the other output 1`] = `
{
  "first": {
    "ok": true,
    "output": "Installed Cursor hook in <home>/.cursor/hooks.json",
  },
  "second": {
    "ok": true,
    "output": "Uninstalled Cursor hook from <home>/.cursor/hooks.json",
  },
  "tree": [
    {
      "kind": "directory",
      "path": ".cursor",
    },
    {
      "content": 
"{
  "version": 1,
  "hooks": {
    "preToolUse": []
  }
}
"
,
      "kind": "file",
      "path": ".cursor/hooks.json",
    },
    {
      "kind": "directory",
      "path": "tmp",
    },
  ],
}
`;

