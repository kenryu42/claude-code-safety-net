{
  "responses": [
    {
      "body": {
        "canPickDirectory": "<platform>",
        "errors": [],
        "projectPath": "<root>/project",
        "rulebooks": [],
        "warnings": [],
      },
      "cacheControl": "no-store",
      "contentType": "application/json; charset=utf-8",
      "status": 200,
    },
  ],
  "tree": [
    {
      "kind": "directory",
      "path": "home",
    },
    {
      "kind": "directory",
      "path": "home/tmp",
    },
    {
      "kind": "directory",
      "path": "project",
    },
  ],
}
`;

