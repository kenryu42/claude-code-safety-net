{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
    "$schema": {
      "description": "JSON Schema reference for IDE support",
    },
    "overrides": {
      "additionalProperties": {
        "anyOf": [
          {
            "const": "off",
            "type": "string",
          },
          {
            "additionalProperties": {},
            "properties": {
              "intent": {
                "enum": [
                  "hard_stop",
                  "use_alternative",
                  "scope_down",
                  "manual_only",
                  "stop_and_explain",
                ],
                "type": "string",
              },
              "reason": {
                "description": "Replacement block reason",
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "reason",
            ],
            "type": "object",
          },
        ],
        "description": "Disable a rule or replace its block reason and intent.",
      },
      "default": {},
      "description": "Rule overrides by id",
      "propertyNames": {
        "pattern": "^[^/]+\\/[^/]+$",
        "type": "string",
      },
      "type": "object",
    },
    "rules": {
      "default": [],
      "description": "Rulebook source strings such as project-rules or owner/repo#main/team-rules",
      "items": {
        "minLength": 1,
        "type": "string",
      },
      "maxItems": 64,
      "type": "array",
    },
    "transparent_wrappers": {
      "default": [],
      "description": "Commands that transparently execute a visible protected child command",
      "items": {
        "description": "Command name such as 'git', 'docker', or 'rtk'.",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
        "type": "string",
      },
      "type": "array",
    },
    "version": {
      "const": 1,
      "description": "Schema version (must be 1)",
      "type": "number",
    },
  },
  "required": [
    "version",
  ],
  "type": "object",
  "~standard": {
    "jsonSchema": {
      "input": [Function],
      "output": [Function],
    },
    "validate": [Function],
    "vendor": "zod",
    "version": 1,
  },
}
`;
