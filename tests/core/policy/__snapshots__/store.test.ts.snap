exports[`the policy store port normalizes exactly as the shipped store does every user policy document salvages to the same canonical policy 2`] = `
{
  "audit": {
    "retention_days": 14,
  },
  "destructive_command_protection": {
    "allow_paths": [
      "/srv/scratch",
      "~/scratch",
    ],
    "enabled": true,
    "overrides": {
      "git.alias-config": "on",
      "git.checkout-force": "off",
    },
  },
  "safety": {
    "level": "strict",
    "overrides": {
      "fail_closed": true,
      "paranoid_interpreters": true,
      "paranoid_rm": false,
    },
  },
  "secret_protection": {
    "allow_paths": [
      "~/work/fixtures/sample.env",
    ],
    "deny_paths": [
      "config/production.env",
    ],
    "enabled": false,
    "overrides": {
      "secret.basename.env": "off",
    },
  },
  "version": 1,
  "workflow": {
    "worktree_mode": true,
  },
}
`;

