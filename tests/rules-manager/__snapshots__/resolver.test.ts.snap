exports[`the bounded GitHub fetch refuses the response that would overrun the operation byte budget 1`] = `
{
  "requests": [
    "GET /api/six-hundred",
    "GET /api/six-hundred",
  ],
  "value": {
    "first": {
      "kind": "returned",
      "value": {
        "head": "                        ",
        "length": 600,
        "status": 200,
      },
    },
    "overBudget": true,
    "requests": 2,
    "second": {
      "kind": "threw",
      "message": "Rule synchronization exceeds CC Safety Net's safe resource limits.",
    },
  },
}
`;

